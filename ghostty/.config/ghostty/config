# Theme
theme = Rose Pine Moon

# Window
background-opacity = 0.8
background-blur = 50
background-opacity-cells = true

# Font (font-family comes from ~/.config/ghostty.local, written by install.sh)
font-size = 14

# Treat left Option as Alt (matches iTerm2 "Esc+" setting)
macos-option-as-alt = true

# Skip the per-read clipboard prompt: any terminal program, including remote
# ones via OSC 52, can read the clipboard (matches the iTerm2 setup)
clipboard-read = allow
clipboard-write = allow

# Machine-local overrides (optional)
config-file = ?../ghostty.local
