#!/usr/bin/env bash

set -euo pipefail

for required in BENCHMARK_AGENT_HOME BENCHMARK_PROMPT_FILE BENCHMARK_SKILLS_DIR BENCHMARK_WORKSPACE; do
  [ -n "${!required:-}" ] || { echo "missing benchmark variable: $required" >&2; exit 2; }
done

base_codex_home="${CODEX_HOME:-$HOME/.codex}"
model="${CODEX_BENCHMARK_MODEL:-gpt-5.6-terra}"

# Keep user skills out of the trial while retaining the saved CLI authentication.
HOME="$BENCHMARK_AGENT_HOME" \
  CODEX_HOME="$base_codex_home" \
  codex exec \
    --ephemeral \
    --ignore-user-config \
    --sandbox workspace-write \
    --model "$model" \
    --cd "$BENCHMARK_WORKSPACE" \
    --skip-git-repo-check \
    "$(<"$BENCHMARK_PROMPT_FILE")"
